<Border x:Class="MyIconButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            CornerRadius="6" Background="Transparent" BorderThickness="0">
    <Border x:Name="PanBack" CornerRadius="6" RenderTransformOrigin="0.5,0.5" BorderThickness="0" IsHitTestVisible="False">
        <Path x:Name="Path" Stretch="Uniform" Margin="5" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <ScaleTransform />
            </Path.RenderTransform>
        </Path>
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
    </Border>
</Border>
