<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyHint x:Name="PanHint" RelativeSetup="HintSnapshot" Theme="Blue" CanClose="True" Margin="0,0,0,15"
                          Text="快照版 PCL 包含尚未正式发布的测试功能，仅限赞助者自己使用。&#xa;请不要随意发给其他人，或是用来制作整合包哦！" />
            <StackPanel x:Name="PanCustom">
            </StackPanel>
            <StackPanel Margin="0,0,0,15">
                <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="EXPLORE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AppTealBrush}" />
                        <TextBlock Text="浏览资源" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBlock Text="从社区寻找新的 Mod、整合包与资源包。" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,14" />
                        <local:MyButton Text="打开下载中心" Height="32" MinWidth="130" MaxWidth="160" HorizontalAlignment="Left" Padding="12,0" ColorType="Highlight"
                                        local:CustomEventService.EventType="切换页面" local:CustomEventService.EventData="Download" />
                    </StackPanel>
                </Border>
                <Border Margin="0,12,0,0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="CONFIGURE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AppTealBrush}" />
                        <TextBlock Text="调整工作区" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBlock Text="管理启动参数、外观、下载与联机设置。" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,14" />
                        <local:MyButton Text="打开设置" Height="32" MinWidth="110" MaxWidth="150" HorizontalAlignment="Left" Padding="12,0"
                                        local:CustomEventService.EventType="切换页面" local:CustomEventService.EventData="Setup" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
